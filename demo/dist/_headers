# Cloudflare Pages headers. Must sit at the root of the build output (dist/),
# which is where Vite copies everything in public/.

# Keep the demo out of search results. index.html also carries a noindex meta
# tag; this covers the case where a crawler only sees the response headers.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Bundles are content-hashed, so a new build always means a new filename.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must revalidate, otherwise visitors keep loading the old bundle.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
